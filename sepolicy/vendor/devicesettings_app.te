# Allow devicesettings_app to find hal_touchfeature_xiaomi_hwservice
allow devicesettings_app hal_touchfeature_xiaomi_hwservice:hwservice_manager find;

# Allow binder communication with hal_touchfeature_xiaomi_default
binder_call(devicesettings_app, hal_touchfeature_xiaomi_default)

# Allow devicesettings_app to write to sysfs_graphics
allow devicesettings_app vendor_sysfs_graphics:file write;
r_dir_file(devicesettings_app, vendor_sysfs_graphics)

# Allow devicesettings_app to r/w disp_param
allow devicesettings_app vendor_sysfs_graphics:dir r_dir_perms;
allow devicesettings_app vendor_sysfs_graphics:file rw_file_perms;

allow devicesettings_app vendor_sysfs_graphics:dir search;

allow devicesettings_app vendor_sysfs_kgsl:dir search;

allow devicesettings_app vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;

allow devicesettings_app vendor_hal_displayfeature_xiaomi_service:binder { call transfer };
allow devicesettings_app vendor_hal_displayfeature_xiaomi_default:binder { call transfer };

allow devicesettings_app vendor_sysfs_battery_supply:dir search;
allow devicesettings_app vendor_sysfs_battery_supply:file r_file_perms;
allow devicesettings_app proc_stat:file { read open getattr };
allow devicesettings_app vendor_sysfs_kgsl_gpuclk:file { read open getattr };
allow devicesettings_app property_socket:sock_file { read write getattr };
allow devicesettings_app init:unix_stream_socket connectto;

# Access standard system services
allow devicesettings_app app_api_service:service_manager find;
allow devicesettings_app audioserver_service:service_manager find;
allow devicesettings_app cameraserver_service:service_manager find;
allow devicesettings_app drmserver_service:service_manager find;
allow devicesettings_app mediaextractor_service:service_manager find;
allow devicesettings_app mediametrics_service:service_manager find;
allow devicesettings_app mediaserver_service:service_manager find;

# Allow reading and writing shared prefs
allow devicesettings_app system_app_data_file:dir create_dir_perms;
allow devicesettings_app system_app_data_file:{ file lnk_file } create_file_perms;

# Allow binder communication with gpuservice
binder_call(devicesettings_app, gpuservice)

# Allow XiaomiParts to write to sysfs_leds
allow devicesettings_app sysfs_leds:file w_file_perms;

# Allow XiaomiParts to write to sysfs_thermal
allow devicesettings_app sysfs_thermal:file w_file_perms;

# Allow XiaomiParts to read/write to sysfs_htsr;
allow devicesettings_app sysfs_htsr:file rw_file_perms;

