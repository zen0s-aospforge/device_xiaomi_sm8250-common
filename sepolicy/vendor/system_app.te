allow system_app vendor_sysfs_battery_supply:dir { search };
allow system_app vendor_sysfs_battery_supply:file { getattr open read };

r_dir_file(system_app, vendor_sysfs_battery_supply)

allow system_app zygote:unix_stream_socket getopt;
allow system_app user_profile_data_file:dir read;
allow system_app sysfs_zram:file { getattr open read };

# Xiaomi Parts
allow system_app sysfs_thermal:file rw_file_perms;
allow system_app nfc_service:service_manager find;
allow system_app vendor_sysfs_graphics:dir r_dir_perms;
allow system_app vendor_sysfs_graphics:file rw_file_perms;
allow system_app hal_xiaomi_fingerprint_hwservice:hwservice_manager find;
binder_call(system_app, hal_fingerprint_default)
